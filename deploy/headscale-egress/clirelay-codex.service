[Unit]
Description=CliRelay Codex-only strong-isolation instance
Documentation=file:/opt/clirelay-codex/share/headscale-egress/README.md
Wants=network-online.target
After=network-online.target tailscaled.service clirelay-codex-firewall.service
Requires=tailscaled.service clirelay-codex-firewall.service

[Service]
Type=exec
User=clirelay-codex
Group=clirelay-codex
EnvironmentFile=/etc/clirelay-codex/environment
WorkingDirectory=/var/log/clirelay-codex
RuntimeDirectory=clirelay-codex
RuntimeDirectoryMode=0700
UMask=0077

# flock is an additional host-local guard. CliRelay also exclusively locks data/egress.db.lock.
ExecStartPre=/usr/bin/test -s /var/lib/clirelay-codex/config/config.yaml
ExecStart=/usr/bin/flock --no-fork --exclusive --nonblock /run/clirelay-codex/instance.lock /opt/clirelay-codex/bin/cli-proxy-api -config /var/lib/clirelay-codex/config/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=true
RestrictSUIDSGID=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# Do not expose AF_UNIX: local proxy or daemon sockets would bypass the
# UID-scoped nftables boundary.
RestrictAddressFamilies=AF_INET AF_INET6

# Only the dedicated auth, egress database, and log directories are writable.
ReadWritePaths=/var/lib/clirelay-codex/auths
ReadWritePaths=/var/lib/clirelay-codex/config/data
ReadWritePaths=/var/log/clirelay-codex
ReadOnlyPaths=/var/lib/clirelay-codex/config/config.yaml
ReadOnlyPaths=/var/lib/clirelay-codex/config/static

[Install]
WantedBy=multi-user.target
