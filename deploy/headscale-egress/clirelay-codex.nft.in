# INTENTIONALLY NOT LOADABLE UNTIL RENDERED.
# Replace the UID and exact addr.port element placeholders. Never replace them with CIDRs,
# wildcard ports, loopback ranges, generic DNS access, or unrestricted HTTPS access.
table inet clirelay_codex {
  set allowed_endpoint_tcp_v4 {
    type ipv4_addr . inet_service
    elements = { __REPLACE_WITH_EXACT_ENDPOINT_IPV4_ADDR_PORT_PAIRS__ }
  }

  set allowed_endpoint_tcp_v6 {
    type ipv6_addr . inet_service
    elements = { __REPLACE_WITH_EXACT_ENDPOINT_IPV6_ADDR_PORT_PAIRS_OR_DELETE_THIS_ELEMENTS_CLAUSE__ }
  }

  set allowed_headscale_tcp_v4 {
    type ipv4_addr . inet_service
    elements = { __REPLACE_WITH_FIXED_HEADSCALE_IPV4__ . 443 }
  }

  set allowed_headscale_tcp_v6 {
    type ipv6_addr . inet_service
    elements = { __REPLACE_WITH_FIXED_HEADSCALE_IPV6_OR_DELETE_THIS_ELEMENTS_CLAUSE__ . 443 }
  }

  chain output {
    type filter hook output priority filter; policy accept;

    # This table constrains only the dedicated Codex service UID.
    meta skuid != __REPLACE_WITH_NUMERIC_CLIRELAY_CODEX_UID__ accept

    meta skuid __REPLACE_WITH_NUMERIC_CLIRELAY_CODEX_UID__ ct state established,related counter accept
    meta skuid __REPLACE_WITH_NUMERIC_CLIRELAY_CODEX_UID__ meta l4proto tcp ip daddr . tcp dport @allowed_endpoint_tcp_v4 counter accept
    meta skuid __REPLACE_WITH_NUMERIC_CLIRELAY_CODEX_UID__ meta l4proto tcp ip6 daddr . tcp dport @allowed_endpoint_tcp_v6 counter accept
    meta skuid __REPLACE_WITH_NUMERIC_CLIRELAY_CODEX_UID__ meta l4proto tcp ip daddr . tcp dport @allowed_headscale_tcp_v4 counter accept
    meta skuid __REPLACE_WITH_NUMERIC_CLIRELAY_CODEX_UID__ meta l4proto tcp ip6 daddr . tcp dport @allowed_headscale_tcp_v6 counter accept

    # New connections to every other IPv4/IPv6 destination and port fail closed.
    meta skuid __REPLACE_WITH_NUMERIC_CLIRELAY_CODEX_UID__ counter reject with icmpx type admin-prohibited
  }
}
