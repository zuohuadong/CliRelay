[Unit]
Description=CliRelay Codex-only nftables kill-switch
Documentation=file:/opt/clirelay-codex/share/headscale-egress/README.md
After=local-fs.target nftables.service
Before=clirelay-codex.service

[Service]
Type=oneshot
ExecStart=/opt/clirelay-codex/share/headscale-egress/apply-nftables.sh /etc/nftables.d/clirelay-codex.nft
ExecReload=/opt/clirelay-codex/share/headscale-egress/apply-nftables.sh /etc/nftables.d/clirelay-codex.nft
RemainAfterExit=true

User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadOnlyPaths=/etc/nftables.d/clirelay-codex.nft
ReadWritePaths=/var/lib/clirelay-codex/firewall-backups

[Install]
WantedBy=multi-user.target
